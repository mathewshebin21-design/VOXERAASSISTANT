# Copy to .env for local development. Never commit real values.
VOXERA_ENV=development
# Runtime API role: must NOT own the tables (row-level security relies on this).
VOXERA_DATABASE_URL=postgresql+psycopg://voxera_app:CHANGE_ME@localhost:5432/voxera
# Schema owner, used only by migrations.
VOXERA_MIGRATION_DATABASE_URL=postgresql+psycopg://voxera_owner:CHANGE_ME@localhost:5432/voxera
# At least 32 random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
VOXERA_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
VOXERA_CORS_ORIGINS=["http://localhost:3000"]
# Development only — must be false in production (enforced at start-up).
VOXERA_EXPOSE_INVITE_TOKENS=true
